# Canonical production URL of the site (no trailing slash).
# Used for metadataBase, canonical URLs, Open Graph URLs, sitemap.xml and robots.txt.
# Set it in Vercel for Production and Preview. Leave it unset in Development.
NEXT_PUBLIC_SITE_URL=https://stresslap.com

# Token from Google Search Console (HTML tag verification method): the content="..." value only.
# Server-side only; it is rendered into the page as the google-site-verification meta tag.
GOOGLE_SITE_VERIFICATION=
